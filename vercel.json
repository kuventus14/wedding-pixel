{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "regions": ["icn1"],
  "functions": {
    "api/index.mjs": { "includeFiles": "data/db.json" }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
